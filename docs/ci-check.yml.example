name: Check
on: [push, pull_request]
jobs:
  offline:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: npm test
      - run: python -m py_compile apps/vgp_startup_sound/player.py
      - run: npm run build:preview
      - run: node kit/tools/preview.js dist/vgp_startup_sound preview render
