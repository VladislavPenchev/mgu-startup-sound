{
  "schema": 1,
  "tools": [{"id": "vgp-startup-net", "path": "native/startup-net", "title": "Startup Sound phone connection", "mguHmi": ["ID7"], "uninstallable": true}],
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": ["kit/runtime", "kit/platform", "kit/localization", "kit/tools", "kit/LICENSE.upstream", "oap-sdk"]
    }
  }
}
